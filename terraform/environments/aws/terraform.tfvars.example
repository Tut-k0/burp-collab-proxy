# AWS Configuration
aws_region     = "us-east-1"
project_name   = "burp-collaborator"
environment    = "prod"
instance_type  = "t3.small"

# Domain Configuration
collaborator_domain = "burp.yourdomain.com"

# Certificate configuration
# Options: "selfsigned", "letsencrypt-route53"
# Only selfsigned is supported currently, route53 is untested
cert_mode = "selfsigned"

# Set to true if you want Terraform to create and manage Route53 hosted zone
# Required when cert_mode = "letsencrypt-route53"
# Set to false if using external DNS provider (like Namecheap)
create_route53_zone = true

# SSH Configuration
# Generate with: cat ~/.ssh/id_rsa.pub
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC... your-email@example.com"
ssh_private_key_path = "~/.ssh/id_rsa"

# Restrict SSH access to your IP for better security
# Get your IP with: curl -s ifconfig.me
ssh_allowed_cidrs = ["0.0.0.0/0"]  # Change to ["YOUR.IP.ADD.RESS/32"] for better security

# Network Configuration
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"

# Storage
root_volume_size = 30
