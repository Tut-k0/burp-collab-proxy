#!/bin/bash
# Certbot renewal hook for Burp Collaborator
# This script runs after successful certificate renewal

set -e

echo "Certificate renewed for {{ collaborator_domain }}"
echo "Restarting services..."

# Restart Burp Collaborator
systemctl restart burp-collaborator
echo "Burp Collaborator restarted"

# Restart Nginx
systemctl restart nginx
echo "Nginx restarted"

# Verify services are running
if systemctl is-active --quiet burp-collaborator && systemctl is-active --quiet nginx; then
    echo "All services successfully restarted"
    exit 0
else
    echo "ERROR: One or more services failed to restart"
    exit 1
fi