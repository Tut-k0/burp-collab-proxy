# Namecheap API credentials for certbot-dns-namecheap

# Your Namecheap username
dns_namecheap_username = {{ namecheap_username }}

# Your Namecheap API key (get from Account Panel > Manage > API Access)
dns_namecheap_api_key = {{ namecheap_api_key }}

# Your public IP address (whitelist this in Namecheap API settings)
dns_namecheap_client_ip = {{ namecheap_client_ip | default(ansible_default_ipv4.address) }}

# Namecheap API endpoint (usually https://api.namecheap.com/xml.response)
dns_namecheap_api_endpoint = {{ namecheap_api_endpoint | default('https://api.namecheap.com/xml.response') }}

# Propagation delay in seconds
dns_namecheap_propagation_seconds = {{ namecheap_propagation_seconds | default(120) }}